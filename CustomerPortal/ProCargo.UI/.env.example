# Copy to .env.local for local development (never commit real values).
# Where the Vite dev server proxies /api to (the ProCargo.API https profile).
VITE_API_PROXY_TARGET=https://localhost:7180
# Base URL used by the browser for API calls. Leave as /api/v1 when the API is served through the same origin.
VITE_API_BASE_URL=/api/v1
