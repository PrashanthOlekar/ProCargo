<Project>
  <!-- Shared build settings for every project in ProCargo.API.sln -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments on public members (only controllers/contracts are documented) -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1716;CA1711;CA2007;CA1062;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1863;CA1873;CA1515;CA1031;CA5394;CA1819;CA1002;CA1056;CA1054;CA1055;CA1034;CA1724;CA1720;CA1707;CA2227</NoWarn>
    <Company>ProCargo Logistics</Company>
    <Product>ProCargo</Product>
    <Copyright>© ProCargo Logistics</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
