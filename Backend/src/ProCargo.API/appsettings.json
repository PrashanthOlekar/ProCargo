{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProCargo": ""
  },
  "Jwt": {
    "Issuer": "https://api.procargo.com",
    "WebAudience": "procargo-web",
    "OperationsAudience": "procargo-operations",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "WebRefreshTokenDays": 14,
    "OperationsRefreshTokenHours": 12
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "InviteTokenMinutes": 1440,
    "OtpHashingKey": "",
    "OtpResendSeconds": 45,
    "ExposeOtpForTesting": false
  },
  "Portals": {
    "WebBaseUrl": "https://www.procargo.com",
    "OperationsBaseUrl": "https://operations.procargo.com"
  },
  "Cors": {
    "AllowedOrigins": [ "https://www.procargo.com", "https://operations.procargo.com" ]
  },
  "FileUpload": {
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerRequest": 5
  },
  "FileStorage": {
    "Provider": "AzureBlob",
    "ContainerName": "procargo-files"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@procargo.com",
    "FromName": "ProCargo Logistics",
    "SmtpPort": 587,
    "EnableSsl": true
  },
  "Sms": {
    "Provider": "Http"
  },
  "Payments": {
    "Gateway": "Razorpay",
    "Currency": "INR"
  },
  "Jobs": {
    "QuotationExpiryEnabled": true
  },
  "Swagger": {
    "Enabled": false
  }
}
