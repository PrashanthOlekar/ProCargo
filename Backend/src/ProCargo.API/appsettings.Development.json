{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "ProCargo": "Server=localhost,1433;Database=ProCargo;User Id=sa;Password=<set-with-user-secrets>;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Issuer": "https://localhost:7180"
  },
  "Security": {
    "ExposeOtpForTesting": true
  },
  "Portals": {
    "WebBaseUrl": "http://localhost:5173",
    "OperationsBaseUrl": "http://localhost:5174"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "App_Data/files"
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": false
  },
  "Sms": {
    "Provider": "None"
  },
  "Payments": {
    "Gateway": "Sandbox"
  },
  "Swagger": {
    "Enabled": true
  }
}
